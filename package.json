{
  "name": "global-media-discovery-web",
  "private": true,
  "version": "1.3.0",
  "scripts": {
    "build:css": "tailwindcss -i web/styles/tailwind.css -o web/assets/tailwind.css --minify",
    "vendor:htmx": "cp node_modules/htmx.org/dist/htmx.min.js web/assets/htmx.min.js",
    "build": "npm run build:css && npm run vendor:htmx"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "htmx.org": "4.0.0-beta6",
    "tailwindcss": "4.3.3"
  }
}
