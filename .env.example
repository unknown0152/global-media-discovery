GMD_VERSION=2.1.1
GMD_SITE_NAME=Global Media Discovery
GMD_SITE_ADDRESS=http://:80
GMD_PUBLIC_URL=http://127.0.0.1:8080
# Optional browser-facing Seerr URL. No Seerr API key is used or exposed.
GMD_SEERR_PUBLIC_URL=
GMD_HTTP_PORT=8080
GMD_HTTPS_PORT=8443
GMD_HTTPS_BIND=127.0.0.1

GMD_UPDATE_INTERVAL_HOURS=24
GMD_PAST_DAYS=365
GMD_FUTURE_DAYS=540
GMD_TVDB_FULL_SCAN_DAYS=7
GMD_TVDB_EXTENDED_LIMIT=600
GMD_TMDB_DETAIL_LIMIT=1200
GMD_TVMAZE_RECENT_DAYS=30
GMD_TVMAZE_BACKFILL_DAYS=365
GMD_TVMAZE_BACKFILL_INTERVAL_DAYS=7
GMD_ENABLE_SIMKL=false
# Confirms the operator has read and accepts https://api.simkl.org/api-rules.
GMD_SIMKL_RULES_ACCEPTED=false
GMD_BACKUP_RETENTION=14

GMD_MAX_QUERY_DAYS=366
GMD_MAX_PAGE_SIZE=200
GMD_LOG_LEVEL=INFO
GMD_LOG_FORMAT=json
